{
  "name": "@pdf-complianttools/engine",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pdfjs": {
      "types": "./dist/pdf/pdfjs.d.ts",
      "import": "./dist/pdf/pdfjs.js"
    },
    "./invoice": {
      "types": "./dist/invoice.d.ts",
      "import": "./dist/invoice.js"
    },
    "./create": {
      "types": "./dist/create.d.ts",
      "import": "./dist/create.js"
    },
    "./qr": {
      "types": "./dist/qr.d.ts",
      "import": "./dist/qr.js"
    },
    "./merge": {
      "types": "./dist/pdf/merge.d.ts",
      "import": "./dist/pdf/merge.js"
    },
    "./recipe": {
      "types": "./dist/recipe.d.ts",
      "import": "./dist/recipe.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "import": "./dist/scan.js"
    },
    "./scan-camera": {
      "types": "./dist/scan-camera.d.ts",
      "import": "./dist/scan-camera.js"
    },
    "./scan-deskew": {
      "types": "./dist/scan-deskew.d.ts",
      "import": "./dist/scan-deskew.js"
    },
    "./batch-zip": {
      "types": "./dist/batch/zip.d.ts",
      "import": "./dist/batch/zip.js"
    },
    "./watcher": {
      "types": "./dist/watcher.d.ts",
      "import": "./dist/watcher.js"
    },
    "./watcher-process": {
      "types": "./dist/watcher-process.d.ts",
      "import": "./dist/watcher-process.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint src test --max-warnings=0",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@types/qrcode": "1.5.5",
    "docx": "9.5.1",
    "exceljs": "4.4.0",
    "fflate": "0.8.2",
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "mammoth": "1.10.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.15.30"
  }
}
