{
  "name": "@pdf-complianttools/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./Button.svelte": "./src/Button.svelte",
    "./FileDrop.svelte": "./src/FileDrop.svelte",
    "./PageThumb.svelte": "./src/PageThumb.svelte",
