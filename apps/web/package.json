{
  "name": "@pdf-complianttools/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "node -e \"fs.rmSync('.svelte-kit',{recursive:true,force:true});fs.rmSync('build',{recursive:true,force:true})\"",
    "dev": "vite dev",
    "lint": "eslint src --max-warnings=0",
    "test": "node --test test/*.test.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@pdf-complianttools/engine": "workspace:*",
    "@pdf-complianttools/ui": "workspace:*",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "svelte-check": "4.7.6",
    "vite": "8.3.0"
  }
}
